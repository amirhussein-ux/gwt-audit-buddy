# =========================
# App Runtime
# =========================
NODE_ENV=development
PORT=4000

# =========================
# Database
# =========================
# Example:
# mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/?appName=Cluster0
MONGODB_URI=

# =========================
# Frontend / CORS
# =========================
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080,http://localhost:8081,http://localhost:8082
FRONTEND_URL=http://localhost:5173
APP_URL=http://localhost:5173

# =========================
# Auth / Session Secrets
# =========================
# Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
JWT_SECRET=

# =========================
# Email (Resend - primary)
# =========================
RESEND_API_KEY=
# Must be a verified sender/domain in Resend
RESEND_FROM_EMAIL=GWT Audit Buddy <noreply@your-verified-domain.com>
# Where user-submitted reports are sent
REPORT_ADMIN_EMAIL=tsekify.customerservice@gmail.com

# =========================
# Email (SMTP - optional fallback)
# Leave blank if not using SMTP
# =========================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# =========================
# AI (optional)
# =========================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# =========================
# Email/Auth timing
# =========================
EMAIL_VERIFICATION_ENABLED=true
EMAIL_VERIFICATION_TOKEN_EXPIRES_MS=86400000
PASSWORD_RESET_TOKEN_EXPIRES_MS=900000

# =========================
# Rate Limit
# =========================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_DISABLED=true

# =========================
# Debug
# =========================
AUDIT_DEBUG=0
SECURITY_DEBUG=0

