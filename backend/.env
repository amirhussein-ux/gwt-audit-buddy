# Frontend origin(s) for CORS - separate multiple with comma
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# JWT/Session secrets (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=f70bfe41a3bea76a81469cb6358733f18ce857a0cace8537b7dca9c29d50d312
JWT_SECRET=f2a8e246b5c7a1d0e9e1d2c73efd110439a5981fa021b9ae00b3cf0e0cd7a370

# Email configuration for password reset and verification
# Leave blank for development (email won't send, but system still works)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Frontend URL for email links
FRONTEND_URL=http://localhost:5173

# Email verification settings
EMAIL_VERIFICATION_ENABLED=true
EMAIL_VERIFICATION_TOKEN_EXPIRES_MS=86400000

# Password reset settings  
PASSWORD_RESET_TOKEN_EXPIRES_MS=900000

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=5

# Debug flags
AUDIT_DEBUG=0
SECURITY_DEBUG=0

