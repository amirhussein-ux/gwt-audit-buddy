# GWT Audit Buddy - Environment Configuration Template
# IMPORTANT: Copy this to .env and fill in with YOUR actual values
# NEVER commit .env to version control - it contains secrets!

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================

# Server port
PORT=4000

# Environment: development, staging, production
NODE_ENV=development

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# MongoDB connection string (with non-admin user credentials)
# Format: mongodb+srv://username:password@cluster.mongodb.net/?appName=AppName
# Get from: MongoDB Atlas → Cluster → Connect → mongoose
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?appName=Cluster0

# ============================================================================
# AUTHENTICATION SECRETS
# ============================================================================

# Session authentication secret (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# 32 bytes = 64 hex characters
SESSION_SECRET=generate_with_crypto_randomBytes_32

# JWT signing secret (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=generate_with_crypto_randomBytes_32

# ============================================================================
# CORS CONFIGURATION
# ============================================================================

# Frontend origin(s) for CORS - separate multiple with comma
# Development: http://localhost:5173,http://localhost:3000,http://localhost:8080
# Production: https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# ============================================================================
# EMAIL CONFIGURATION (Optional for development)
# ============================================================================

# SMTP Host for sending emails (e.g., smtp.gmail.com)
SMTP_HOST=

# SMTP Port (typically 587 for TLS or 465 for SSL)
SMTP_PORT=587

# SMTP Username/Email for authentication
SMTP_USER=

# SMTP Password or App-Specific password
SMTP_PASSWORD=

# From email address for system emails
SMTP_FROM=noreply@masid.gov.ph

# ============================================================================
# AI/GEMINI CONFIGURATION
# ============================================================================

# Google Gemini API Key (optional, for AI content analysis)
# Get from: Google Cloud Console → APIs & Services → Credentials
GEMINI_API_KEY=

# Gemini model to use (e.g., gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# ============================================================================
# EMAIL VERIFICATION & PASSWORD RESET (Milliseconds)
# ============================================================================

# Email verification token expiry (24 hours = 86400000 ms)
EMAIL_VERIFICATION_TOKEN_EXPIRES_MS=86400000

# Password reset token expiry (15 minutes = 900000 ms)
PASSWORD_RESET_TOKEN_EXPIRES_MS=900000

# ============================================================================
# RATE LIMITING
# ============================================================================

# Rate limit window (15 minutes = 900000 ms)
RATE_LIMIT_WINDOW_MS=900000

# Maximum login attempts per window
RATE_LIMIT_MAX_REQUESTS=5

# ============================================================================
# FRONTEND CONFIGURATION (Vite)
# ============================================================================

# Frontend API endpoint
VITE_API_URL=http://localhost:4000

# Demo credentials (DEVELOPMENT ONLY)
# Never set these in production
VITE_DEMO_EMAIL=
VITE_DEMO_PASSWORD=
VITE_SHOW_DEMO_CREDENTIALS=false

# ============================================================================
# DEBUG FLAGS (Development only)
# ============================================================================

# Enable audit logging debug output
AUDIT_DEBUG=0

# Enable security debug output
SECURITY_DEBUG=0

# ============================================================================
# NOTES
# ============================================================================

# 1. Never commit the actual .env file - only .env.example with placeholders
# 2. Use .env.local for local development (automatically Git-ignored)
# 3. For production, set environment variables via your deployment platform
# 4. All SECRET values must be securely generated and stored
# 5. Rotate secrets regularly and update all copies
# 6. Use strong, random values for SESSION_SECRET and JWT_SECRET
